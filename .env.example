DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
ASF_USERNAME=you_username_in_nasa_site
ASF_PASSWORD=your_password_in_nasa_site

# Cap on the 3-band preview GeoTIFF this project generates from raw SAR bands.
MAX_GEOTIFF_BYTES=104857600

# The GeoAI models API (separate project, deployed on Hugging Face Spaces).
# Example: https://your-username-geoai-models.hf.space
GEOAI_API_BASE_URL=
GEOAI_API_TIMEOUT=120
